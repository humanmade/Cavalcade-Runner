#!/usr/bin/env php
<?php
/**
 * Cavalcade
 */

//@codingStandardsIgnoreLine
namespace HM\Cavalcade\Runner;

use Exception;

include dirname( __DIR__ ) . '/bootstrap.php';

// Add help text when -h or --help is used
$options = getopt( 'h', [ 'help' ] );
if ( isset( $options['h'] ) || isset( $options['help'] ) ) {
	$script_name = basename( $argv[0] );
	$header = <<<EOF
This is daemon for Cavalcade, a scalable WordPress jobs system.
More information: https://github.com/humanmade/Cavalcade
Usage: $script_name /path/to/wordpress
EOF;

	fwrite( STDERR, $header );
	exit( 0 );
}

$wp_path = isset( $argv[1] ) ? $argv[1] : '.';

$runner_options = [];

// Allow the worker count to be matched to the host via the environment.
$max_workers = getenv( 'CAVALCADE_MAX_WORKERS' );
if ( $max_workers !== false && $max_workers !== '' ) {
	$max_workers = filter_var( $max_workers, FILTER_VALIDATE_INT, [ 'options' => [ 'min_range' => 1 ] ] );
	if ( $max_workers === false ) {
		fwrite( STDERR, 'CAVALCADE_MAX_WORKERS must be a positive integer, using the default instead.' . PHP_EOL );
	} else {
		$runner_options['max_workers'] = $max_workers;
	}
}

$runner = Runner::instance( $runner_options );
try {
	$runner->bootstrap( $wp_path );
	$runner->run();
} catch ( SignalInterrupt $e ) {
	printf( PHP_EOL . 'Shutting down! (%s: %d)' . PHP_EOL, $e->getMessage(), $e->getCode() );
	exit( 0 );
} catch ( Exception $e ) {
	fwrite( STDERR, sprintf( 'Error: %s' . PHP_EOL, $e->getMessage() ) );
	fwrite( STDERR, $e->getTraceAsString() . PHP_EOL );
	exit( 1 );
}
